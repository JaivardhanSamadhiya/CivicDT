# No secrets are needed for the complete deterministic demonstration.
# Keep keys in .env.local; never commit that file.
AI_PROVIDER=demo

# Optional server-only proposal extraction. Change AI_PROVIDER to openai to opt in.
# Proposal text is then sent to OpenAI. Quantitative results remain deterministic.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
